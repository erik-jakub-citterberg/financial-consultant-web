{
  "name": "financial-consultant-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "SEO-first Slovak website for a freelance financial/insurance/OVB consultant in central Slovakia.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node quality/sk-typo.mjs",
    "preview": "astro preview",
    "lint:copy": "node quality/copy-lint.mjs",
    "lint:style": "node quality/style-lint.mjs",
    "lint:images": "node quality/image-check.mjs",
    "validate:schema": "node quality/schema-validate.mjs",
    "quality": "npm run lint:copy && npm run lint:style && npm run lint:patterns && npm run lint:images",
    "quality:built": "npm run validate:schema && npm run check:carons",
    "check:carons": "node quality/caron-render.mjs",
    "lint:patterns": "node quality/pattern-lint.mjs"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource-variable/epilogue": "^5.3.0",
    "astro": "^4.15.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "lefthook": "^1.7.0"
  }
}
