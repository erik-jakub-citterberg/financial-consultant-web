---
import '../styles/base.css';
import '@fontsource-variable/fraunces';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FinancialService',
      '@id': new URL('/#business', Astro.site).toString(),
      name: 'Erika Zajaková – dane a finančné poradenstvo',
      areaServed: ['Brezno', 'Michalová', 'Podbrezová', 'Banská Bystrica'],
      telephone: '+421907824728',
      email: 'erika.zajakova@gmail.com',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Michalová',
        postalCode: '976 57',
        addressRegion: 'Banskobystrický kraj',
        addressCountry: 'SK',
      },
      founder: { '@id': new URL('/#erika', Astro.site).toString() },
      url: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'Person',
      '@id': new URL('/#erika', Astro.site).toString(),
      name: 'Erika Zajaková',
      honorificPrefix: 'Ing.',
      jobTitle: 'Finančná poradkyňa',
      worksFor: 'OVB Allfinanz Slovensko, a.s.',
      alumniOf: 'Bankovní institut vysoká škola, Praha',
    },
  ],
};
---
<!doctype html>
<html lang="sk-SK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class="container" style="display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);padding-block:var(--space-3);flex-wrap:wrap;">
      <a href="/" style="font-family:var(--font-heading);font-weight:600;font-size:var(--step-1);color:var(--color-brand-strong);">Erika Zajaková</a>
      <nav style="display:flex;align-items:center;gap:var(--space-4);">
        <a href="/o-mne">O mne</a>
        <a href="/kontakt">Kontakt</a>
        <a href="tel:+421907824728" class="btn">0907 824 728</a>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="container" style="padding-block:var(--space-5);color:var(--color-muted);font-size:var(--step--1);border-top:1px solid var(--color-line);margin-top:var(--space-6);">
      <p>Erika Zajaková · IČO 40485242 · Slobodné povolanie – fyzická osoba podnikajúca na základe iného ako živnostenského zákona.</p>
      <p>Michalová, okres Brezno · 0907 824 728 · erika.zajakova@gmail.com</p>
    </footer>
  </body>
</html>
