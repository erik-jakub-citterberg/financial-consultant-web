---
import '../styles/base.css';
import '@theme/theme.css';
import faviconUrl from '@theme/favicon.svg?url';
import { office, officeLine } from '../data/office';
import { getCollection } from 'astro:content';
const towns = (await getCollection('towns')).sort((a, b) => a.data.order - b.data.order);
import { ViewTransitions } from 'astro:transitions';

interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// First path segment, so a theme can colour-code a page by service (poistenie, hypoteky, ...)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const section = Astro.url.pathname.slice(base.length).split('/').filter(Boolean)[0] || 'home';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FinancialService',
      '@id': new URL('/#business', Astro.site).toString(),
      name: 'Erika Zajaková – dane a finančné poradenstvo',
      areaServed: [...towns.map((t) => t.data.name), 'Slovensko'],
      telephone: '+421907824728',
      email: 'erika.zajakova@gmail.com',
      address: { '@type': 'PostalAddress', streetAddress: office.street, addressLocality: office.city, postalCode: office.postalCode, addressRegion: office.region, addressCountry: 'SK' },
      founder: { '@id': new URL('/#erika', Astro.site).toString() },
      url: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'Person',
      '@id': new URL('/#erika', Astro.site).toString(),
      name: 'Erika Zajaková',
      honorificPrefix: 'Ing.',
      jobTitle: 'Finančná poradkyňa',
      worksFor: 'OVB Allfinanz Slovensko, a.s.',
      alumniOf: 'Bankovní institut vysoká škola, Praha',
    },
  ],
};
---
<!doctype html>
<html lang="sk-SK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    {(process.env.PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script src="/enhance.js" defer></script>
    <ViewTransitions />
  </head>
  <body data-section={section}>
    <div class="topbar">
      <div class="container">
        <span class="topbar-creds">OVB Allfinanz · Ing. Erika Zajaková · Prax od 2002</span>
        <a href="tel:+421907824728">0907 824 728</a>
      </div>
    </div>
    <div class="site-header-wrap" id="hdr">
      <header class="site-header container">
        <a href="/" class="brand"><strong>Erika Zajaková</strong><span>Finančná poradkyňa OVB · Brezno</span></a>
        <button class="nav-toggle" aria-label="Otvoriť menu" aria-expanded="false" aria-controls="main-nav">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav" id="main-nav">
          <a href="/poistenie">Poistenie</a>
          <a href="/financne-poradenstvo">Investície</a>
          <a href="/hypoteky">Hypotéky</a>
          <a href="/dane">Dane</a>
          <a href="/kariera">Kariéra</a>
          <a href="/o-mne">O mne</a>
          <a href="/kontakt" class="btn">Konzultácia</a>
        </nav>
      </header>
    </div>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>Erika Zajaková · IČO 40485242 · Slobodné povolanie, fyzická osoba podnikajúca na základe iného ako živnostenského zákona.</p>
      <p>Kancelária: {officeLine} · 0907 824 728 · erika.zajakova@gmail.com</p>
      <p>Služby: <a href="/poistenie">Poistenie</a>, <a href="/financne-poradenstvo">Investície a sporenie</a>, <a href="/hypoteky">Hypotéky</a>, <a href="/dane">Dane a účtovníctvo</a>, <a href="/cennik">Cenník</a> · <a href="/kariera">Kariéra v OVB</a> · <a href="/blog">Blog</a></p>
      <p>Regióny: {towns.map((t, i) => <>{i > 0 && ", "}<a href={`/${t.slug}`}>{t.data.name}</a></>)}</p>
    </footer>
  </body>
</html>
