---
import '../styles/base.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource-variable/dm-sans';
import { ViewTransitions } from 'astro:transitions';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FinancialService',
      '@id': new URL('/#business', Astro.site).toString(),
      name: 'Erika Zajaková – dane a finančné poradenstvo',
      areaServed: ['Brezno', 'Michalová', 'Podbrezová', 'Banská Bystrica'],
      telephone: '+421907824728',
      email: 'erika.zajakova@gmail.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Michalová', postalCode: '976 57', addressRegion: 'Banskobystrický kraj', addressCountry: 'SK' },
      founder: { '@id': new URL('/#erika', Astro.site).toString() },
      url: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'Person',
      '@id': new URL('/#erika', Astro.site).toString(),
      name: 'Erika Zajaková',
      honorificPrefix: 'Ing.',
      jobTitle: 'Finančná poradkyňa',
      worksFor: 'OVB Allfinanz Slovensko, a.s.',
      alumniOf: 'Bankovní institut vysoká škola, Praha',
    },
  ],
};
---
<!doctype html>
<html lang="sk-SK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script src="/enhance.js" defer></script>
    <ViewTransitions />
  </head>
  <body>
    <div class="topbar">
      <div class="container">
        <span class="topbar-creds">OVB Allfinanz · Ing. Erika Zajaková · Prax od 2002</span>
        <a href="tel:+421907824728">0907 824 728</a>
      </div>
    </div>
    <div class="site-header-wrap" id="hdr">
      <header class="site-header container">
        <a href="/" class="brand"><strong>Erika Zajaková</strong><span>Dane · Financie · Poradenstvo</span></a>
        <button class="nav-toggle" aria-label="Otvoriť menu" aria-expanded="false" aria-controls="main-nav">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav" id="main-nav">
          <a href="/dane">Dane a účtovníctvo</a>
          <a href="/hypoteky">Hypotéky</a>
          <a href="/poistenie">Poistenie</a>
          <a href="/financne-poradenstvo">Financie</a>
          <a href="/cennik">Cenník</a>
          <a href="/o-mne">O mne</a>
          <a href="/blog">Blog</a>
          <a href="/kontakt" class="btn">Konzultácia</a>
        </nav>
      </header>
    </div>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>Erika Zajaková · IČO 40485242 · Slobodné povolanie, fyzická osoba podnikajúca na základe iného ako živnostenského zákona.</p>
      <p>Michalová, okres Brezno · 0907 824 728 · erika.zajakova@gmail.com</p>
      <p>Služby: <a href="/dane">Dane a účtovníctvo</a>, <a href="/hypoteky">Hypotéky</a>, <a href="/poistenie">Poistenie</a>, <a href="/cennik">Cenník</a></p>
      <p>Regióny: <a href="/brezno">Brezno</a>, <a href="/michalova">Michalová</a>, <a href="/podbrezova">Podbrezová</a>, <a href="/banska-bystrica">Banská Bystrica</a></p>
    </footer>
  </body>
</html>
