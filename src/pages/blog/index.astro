---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => p.data.draft !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date): string {
  const d = date.getDate().toString().padStart(2, '0');
  const m = (date.getMonth() + 1).toString().padStart(2, '0');
  const y = date.getFullYear();
  return `${d}. ${m}. ${y}`;
}
---

<BaseLayout
  title="Blog | Erika Zajaková"
  description="Články o poistení, sporení, hypotékach a daniach. Prakticky a zrozumiteľne, od finančnej poradkyne OVB z Brezna."
>
  <div class="page-header">
    <h1>Články o financiách, poistení a daniach</h1>
  </div>

  {posts.length === 0 ? (
    <p>Čoskoro pridáme prvé články.</p>
  ) : (
    <ul class="blog-list">
      {posts.map((post) => (
        <li class="blog-item">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .blog-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .blog-item {
    border-bottom: 1px solid var(--color-line);
    padding-bottom: var(--space-4);
  }

  .blog-item time {
    font-size: var(--step--1);
    color: var(--color-muted);
    display: block;
    margin-bottom: var(--space-1);
  }

  .blog-item h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-1);
  }

  .blog-item p {
    color: var(--color-muted);
    font-size: var(--step-0);
  }
</style>
