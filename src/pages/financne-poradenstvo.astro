---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Faq from '../components/Faq.astro';
const faq = [
  { q: 'Koľko stojí poradenstvo?', a: 'Prvá konzultácia je bezplatná a nezáväzná. Za sprostredkovanie ma odmeňuje finančná inštitúcia, nie vy.' },
  { q: 'S čím mi viete pomôcť?', a: 'S výberom hypotéky, s nastavením životného a majetkového poistenia a so sporením či investíciami.' },
];
---
<BaseLayout
  title="Finančné poradenstvo Brezno: hypotéky, poistenie, sporenie | Erika Zajaková"
  description="Hypotéky, poistenie a sporenie cez OVB Allfinanz v regióne Brezno a Banská Bystrica. Prvá konzultácia zdarma. Poradkyňa od roku 2002."
>
  <section class="section" data-reveal>
    <p class="eyebrow">Finančné poradenstvo</p>
    <h1>Hypotéky, poistenie a sporenie</h1>
    <p class="lede">Ako poradkyňa OVB Allfinanz od roku 2002 vám pomôžem s tromi vecami, ktoré spolu tvoria zdravé rodinné financie.</p>

    <div class="cards">
      <ServiceCard title="Hypotéky" href="/hypoteky"><p>Výber a vybavenie hypotéky pri kúpe, stavbe alebo refinancovaní.</p></ServiceCard>
      <ServiceCard title="Poistenie" href="/poistenie"><p>Životné a majetkové poistenie nastavené podľa vašej situácie.</p></ServiceCard>
      <article class="card"><h3>Sporenie a investície</h3><p>Plán sporenia na dôchodok, pre deti alebo na väčšie ciele. Prejdeme možnosti na stretnutí.</p></article>
    </div>

    <p class="note" style="margin-top:var(--space-4);">Prvá konzultácia je bezplatná a nezáväzná. Za sprostredkovanie ma odmeňuje finančná inštitúcia, vy za poradenstvo neplatíte.</p>

    <h2 style="margin-top:var(--space-5);">Časté otázky</h2>
    <Faq items={faq} />

    <p style="margin-top:var(--space-5);"><a class="btn" href="/kontakt">Dohodnúť si konzultáciu</a></p>
  </section>
</BaseLayout>
