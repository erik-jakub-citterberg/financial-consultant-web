---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
const faq = [
  { q: 'Koľko stojí konzultácia?', a: 'Prvá konzultácia je bezplatná a nezáväzná. Za sprostredkovanie ma odmeňuje finančná inštitúcia, nie vy.' },
  { q: 'S čím mi viete pomôcť?', a: 'S výberom hypotéky, s nastavením životného a majetkového poistenia a so sporením či investíciami.' },
  { q: 'Ako prebieha výber hypotéky?', a: 'Prejdeme vašu situáciu a možnosti, porovnáme ponuky a vyberieme tú, ktorá vám sadne. Pomôžem aj s podkladmi.' },
];
---
<BaseLayout
  title="Finančné poradenstvo, hypotéky a poistenie Brezno | Erika Zajaková"
  description="Hypotéky, životné a majetkové poistenie a sporenie cez OVB Allfinanz v regióne Brezno a Banská Bystrica. Prvá konzultácia zdarma."
>
  <section class="section">
    <p class="eyebrow">Finančné poradenstvo</p>
    <h1>Hypotéky, poistenie a sporenie</h1>
    <div class="prose">
      <p>Ako poradkyňa OVB Allfinanz od roku 2002 vám pomôžem vybrať hypotéku podľa vašej situácie, nastaviť životné a majetkové poistenie a naplánovať sporenie.</p>
    </div>

    <div class="cards">
      <article class="card"><h3>Hypotéky</h3><p>Porovnanie ponúk bánk a pomoc s podkladmi pri kúpe, stavbe alebo refinancovaní.</p></article>
      <article class="card"><h3>Poistenie</h3><p>Životné a majetkové poistenie nastavené podľa toho, čo naozaj potrebujete.</p></article>
      <article class="card"><h3>Sporenie a investície</h3><p>Plán sporenia na dôchodok, pre deti alebo na väčšie ciele.</p></article>
    </div>

    <p class="note" style="margin-top:var(--space-4);">Prvá konzultácia je bezplatná a nezáväzná. Za sprostredkovanie ma odmeňuje finančná inštitúcia, vy za poradenstvo neplatíte.</p>

    <h2 style="margin-top:var(--space-5);">Časté otázky</h2>
    <Faq items={faq} />

    <p style="margin-top:var(--space-5);"><a class="btn" href="/kontakt">Dohodnúť si konzultáciu</a></p>
  </section>
</BaseLayout>
