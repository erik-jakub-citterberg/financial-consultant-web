---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
const faq = [
  { q: 'Koľko stojí finančné poradenstvo?', a: 'Prvá konzultácia je bezplatná a nezáväzná.' },
  { q: 'Musíme sa stretnúť osobne?', a: 'Nemusíme. Konzultáciu spravíme aj cez Zoom, WhatsApp, Messenger alebo telefonicky a zmluvu podpíšete online.' },
  { q: 'Čo je sporenie cez OVB?', a: 'Sporenie cez OVB Allfinanz prebieha cez pravidelné vklady do investičných fondov alebo životných poistení so sporiacou zložkou, podľa vášho cieľa a horizontu.' },
  { q: 'Kedy sa mi oplatí investovať?', a: 'Investovanie má zmysel vtedy, keď máte stabilný príjem, odloženú rezervu na horšie časy a horizont aspoň päť rokov. Spoločne to prejdeme a nastavíme plán, ktorý zodpovedá vašej situácii.' },
  { q: 'Je dôchodkové sporenie stále výhodné?', a: 'Tretí pilier (doplnkové dôchodkové sporenie) stále prináša daňovú úľavu a u mnohých zamestnávateľov aj príspevok od nich. Pri druhom pilieri záleží na veku a situácii. Prejdeme to spolu.' },
];
---
<BaseLayout
  title="Sporenie a investície Brezno | Erika Zajaková"
  description="Sporenie, investície a dôchodkové poradenstvo cez OVB Allfinanz v regióne Brezno. Prvá konzultácia zdarma. Poradkyňa od roku 2002."
>
  <div class="page-header" style="margin-bottom: var(--space-3);">
    <h1>Sporenie a investície</h1>
    <p class="lede">Pomôžem vám vybrať a nastaviť sporenie tak, aby zodpovedalo vašim cieľom – či už ide o rezervu, bývanie, deti alebo dôchodok.</p>
  </div>

  <section class="section">
    <div class="cards">
      <article class="card">
        <h3>Sporenie na cieľ</h3>
        <p>Pravidelné sporenie do podielových fondov alebo do poistenia so sporiacou zložkou. Nastavíme sumu a horizont podľa toho, čo chcete dosiahnuť.</p>
      </article>
      <article class="card">
        <h3>Dôchodkové sporenie</h3>
        <p>Druhý a tretí pilier, ich výhody a daňové úľavy. Prejdeme váš aktuálny stav a zhodnotíme, či sa oplatí niečo zmeniť.</p>
      </article>
      <article class="card">
        <h3>Sporenie pre deti</h3>
        <p>Dlhodobé sporenie od narodenia dieťaťa. Pri dlhom horizonte mali investičné fondy v minulosti vyšší výnos ako bežný účet, ich hodnota však môže kolísať.</p>
      </article>
    </div>

    <p class="note" style="margin-top:var(--space-4);">Prvá konzultácia je bezplatná a nezáväzná.</p>
  </section>

  <section class="section">
    <h2>Časté otázky</h2>
    <div class="faq" style="margin-top:var(--space-4);">
      <Faq items={faq} />
    </div>
    <p style="margin-top:var(--space-5);"><a class="btn" href="/kontakt">Dohodnúť si konzultáciu</a></p>
  </section>
</BaseLayout>
