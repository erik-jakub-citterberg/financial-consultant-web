---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
const faq = [
  { q: 'Koľko stojí finančné poradenstvo?', a: 'Prvá konzultácia je bezplatná a nezáväzná. Za sprostredkovanie ma odmeňuje finančná inštitúcia; vy za poradenstvo neplatíte nič.' },
  { q: 'Čo je sporenie cez OVB?', a: 'Sporenie cez OVB Allfinanz prebieha cez pravidelné vklady do investičných fondov alebo životných poistení so sporiacou zložkou, podľa vášho cieľa a horizontu.' },
  { q: 'Kedy sa mi oplatí investovať?', a: 'Investovanie má zmysel vtedy, keď máte stabilný príjem, krytý núdzový fond a horizont aspoň päť rokov. Spoločne to prejdeme a nastavíme plán, ktorý zodpovedá vašej situácii.' },
  { q: 'Je dôchodkové sporenie stále výhodné?', a: 'Tretí pilier (doplnkové dôchodkové sporenie) stále prináša daňovú úľavu a príspevok zamestnávateľa. Druhý pilier závisí od veku a situácie. Porovnám to s vami.' },
];
---
<BaseLayout
  title="Sporenie a investície Brezno | Erika Zajaková"
  description="Sporenie, investície a dôchodkové poradenstvo cez OVB Allfinanz v regióne Brezno. Prvá konzultácia zdarma. Poradkyňa od roku 2002."
>
  <div class="page-header">
    <p class="eyebrow">Finančné poradenstvo</p>
    <h1>Sporenie a investície</h1>
    <p class="lede">Pomôžem vám vybrať a nastaviť sporenie tak, aby zodpovedalo vašim cieľom — či už ide o rezervu, bývanie, deti alebo dôchodok.</p>
  </div>

  <section class="section">
    <div class="cards">
      <article class="card">
        <h3>Sporenie na cieľ</h3>
        <p>Pravidelné sporenie do fondov alebo produktov so zaručeným výnosom. Nastavíme sumu a horizont podľa toho, čo chcete dosiahnuť.</p>
      </article>
      <article class="card">
        <h3>Dôchodkové sporenie</h3>
        <p>Druhý a tretí pilier, ich výhody a daňové úľavy. Prejdeme váš aktuálny stav a zhodnotíme, či sa oplatí niečo zmeniť.</p>
      </article>
      <article class="card">
        <h3>Sporenie pre deti</h3>
        <p>Dlhodobý plán, kde peniaze pracujú od narodenia. Investičné fondy s dlhým horizontom prinášajú oveľa viac ako bežný účet.</p>
      </article>
    </div>

    <p class="note" style="margin-top:var(--space-4);">Prvá konzultácia je bezplatná a nezáväzná. Za sprostredkovanie ma odmeňuje finančná inštitúcia; vy za poradenstvo neplatíte.</p>
  </section>

  <section class="section">
    <h2>Časté otázky</h2>
    <div class="faq" style="margin-top:var(--space-4);">
      <Faq items={faq} />
    </div>
    <p style="margin-top:var(--space-5);"><a class="btn" href="/kontakt">Dohodnúť si konzultáciu</a></p>
  </section>
</BaseLayout>
