---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const SVG = `fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"`;
const icons = {
  tax:    `<svg viewBox="0 0 24 24" ${SVG}><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 13 11 15 15 11"/></svg>`,
  house:  `<svg viewBox="0 0 24 24" ${SVG}><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  shield: `<svg viewBox="0 0 24 24" ${SVG}><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  growth: `<svg viewBox="0 0 24 24" ${SVG}><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
};

---
<BaseLayout
  title="Dane, poistenie a hypotéky v Brezne a okolí | Erika Zajaková"
  description="Erika Zajaková: daňové priznania, účtovníctvo, mzdy, personalistika a finančné poradenstvo OVB v regióne Brezno. Prax od roku 2002."
>
  <section class="hero">
    <svg class="hero-rings" viewBox="0 0 500 500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <circle cx="470" cy="470" r="70"  fill="none" stroke="rgba(194,137,47,0.55)" stroke-width="1.5"/>
      <circle cx="470" cy="470" r="130" fill="none" stroke="rgba(194,137,47,0.38)" stroke-width="1.5"/>
      <circle cx="470" cy="470" r="200" fill="none" stroke="rgba(194,137,47,0.22)" stroke-width="1.5"/>
      <circle cx="470" cy="470" r="285" fill="none" stroke="rgba(194,137,47,0.13)" stroke-width="1"/>
      <circle cx="470" cy="470" r="385" fill="none" stroke="rgba(194,137,47,0.07)" stroke-width="1"/>
    </svg>
    <div class="hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Dane a financie v regióne Brezno</p>
        <h1>Dane, poistenie a&nbsp;hypotéky v&nbsp;Brezne a&nbsp;okolí</h1>
        <p class="lede">Som Erika Zajaková. Od roku 2002 pracujem ako finančná poradkyňa OVB a od roku 2006 spracúvam daňové priznania, vediem účtovníctvo a spracúvam mzdy pre ľudí a firmy v regióne.</p>
        <p style="margin-top: var(--space-5);"><a class="btn btn-gold" href="/kontakt">Dohodnúť si nezáväznú konzultáciu</a></p>
      </div>
      <div class="facts">
        <div class="fact"><b>2002</b><span>Finančná poradkyňa OVB od roku</span></div>
        <div class="fact"><b>2006</b><span>Dane a jednoduché účtovníctvo od roku</span></div>
        <div class="fact"><b>Ing.</b><span>Financie a ekonómia, Praha</span></div>
        <div class="fact"><b>Brezno</b><span>Michalová, okres Brezno</span></div>
      </div>
    </div>
  </section>

  <div class="stats-strip" data-reveal>
    <div class="container">
      <div class="statline" data-stagger>
        <div class="stat">
          <span class="n" data-count="24">24</span>
          <span class="l">rokov praxe</span>
        </div>
        <div class="stat">
          <span class="n">2</span>
          <span class="l">oblasti pod jednou strechou</span>
        </div>
        <div class="stat">
          <span class="n">1:1</span>
          <span class="l">osobný prístup ku klientovi</span>
        </div>
      </div>
    </div>
  </div>

  <section class="section" data-reveal>
    <p class="eyebrow">S čím pomôžem</p>
    <h2>Štyri služby, jedna poradkyňa</h2>
    <div class="cards cards--2col" data-stagger>
      <ServiceCard title="Dane a účtovníctvo" href="/dane" icon={icons.tax}>
        <p>Daňové priznania, jednoduché a podvojné účtovníctvo, mzdy a personalistika.</p>
      </ServiceCard>
      <ServiceCard title="Hypotéky" href="/hypoteky" icon={icons.house}>
        <p>Výber a vybavenie hypotéky pri kúpe, stavbe alebo refinancovaní. Porovnám ponuky bánk za vás.</p>
      </ServiceCard>
      <ServiceCard title="Poistenie" href="/poistenie" icon={icons.shield}>
        <p>Životné a majetkové poistenie nastavené podľa toho, čo naozaj potrebujete vy a vaša rodina.</p>
      </ServiceCard>
      <ServiceCard title="Sporenie a investície" href="/financne-poradenstvo" icon={icons.growth}>
        <p>Sporenie na cieľ, dôchodkové piliere a plán pre deti. Nastavíme to spoločne podľa vašej situácie.</p>
      </ServiceCard>
    </div>
  </section>

  <div class="steps-section" data-reveal>
    <p class="eyebrow">Ako to prebieha</p>
    <h2>Od prvého telefonátu po hotové riešenie</h2>
    <div class="steps" data-stagger>
      <div class="step">
        <svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.5 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.41 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.36a16 16 0 0 0 5.93 5.93l1.72-1.72a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <strong>Zavoláte alebo napíšete</strong>
        <p>Dohodneme si termín — u vás, v Michalovej alebo online podľa toho, čo vám vyhovuje.</p>
      </div>
      <div class="step">
        <svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <strong>Prejdeme vašu situáciu</strong>
        <p>Spolu si pozrieme doklady, zmluvy a čo treba vyriešiť. Nič vopred nemusíte pripravovať.</p>
      </div>
      <div class="step">
        <svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        <strong>Dostanete hotové riešenie</strong>
        <p>Pripravím všetko za vás a vysvetlím každý krok jednoducho, aby ste vedeli, za čo platíte.</p>
      </div>
    </div>
    <p style="margin-top:var(--space-5);"><a class="btn btn-gold" href="/kontakt">Konzultácia</a></p>
  </div>

</BaseLayout>
