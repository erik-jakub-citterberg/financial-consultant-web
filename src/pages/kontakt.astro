---
import BaseLayout from '../layouts/BaseLayout.astro';
import { office, officeLine } from '../data/office';
---
<BaseLayout
  title="Kontakt | Erika Zajaková"
  description="Kontakt na Eriku Zajakovú: 0907 824 728, erika.zajakova@gmail.com. Kancelária v Brezne, konzultácie aj online cez Zoom, WhatsApp alebo telefón."
>
  <section class="section" style="max-width:40rem;">
    <h1>Ozvite sa mi</h1>
    <div class="prose">
      <p>Zavolajte alebo napíšte a dohodneme si termín. Stretnúť sa môžeme v mojej kancelárii v Brezne alebo u vás.</p>
      <p>Všetko sa dá vybaviť aj na diaľku: poradíme sa cez Zoom, WhatsApp, Messenger alebo telefonicky a zmluvy aj poistky podpíšete online, bez osobného stretnutia.</p>
      <p>
        Telefón: <a href="tel:+421907824728">0907 824 728</a><br />
        WhatsApp: <a href="https://wa.me/421907824728" rel="noopener">napísať správu</a><br />
        E-mail: <a href="mailto:erika.zajakova@gmail.com">erika.zajakova@gmail.com</a><br />
        Kancelária: <a href={office.mapsUrl} rel="noopener">{officeLine}</a>
      </p>
    </div>

    <!-- Netlify Forms: submissions appear in Netlify → Forms; turn on e-mail notifications there. -->
    <form name="kontakt" method="POST" action="/dakujem" data-netlify="true" netlify-honeypot="web" style="margin-top:var(--space-5);display:grid;gap:var(--space-3);">
      <input type="hidden" name="form-name" value="kontakt" />
      <p hidden><label>Nevypĺňajte: <input name="web" /></label></p>
      <label>Meno<br /><input name="meno" type="text" required style="width:100%;padding:var(--space-2);border:1px solid var(--color-line);border-radius:var(--radius-sm);" /></label>
      <label>E-mail<br /><input name="email" type="email" required style="width:100%;padding:var(--space-2);border:1px solid var(--color-line);border-radius:var(--radius-sm);" /></label>
      <label>Telefón<br /><input name="telefon" type="tel" style="width:100%;padding:var(--space-2);border:1px solid var(--color-line);border-radius:var(--radius-sm);" /></label>
      <label>Správa<br /><textarea name="sprava" rows="4" required style="width:100%;padding:var(--space-2);border:1px solid var(--color-line);border-radius:var(--radius-sm);"></textarea></label>
      <label style="display:flex;gap:var(--space-2);align-items:flex-start;font-size:var(--step--1);color:var(--color-muted);">
        <input name="suhlas" type="checkbox" required />
        <span>Súhlasím so spracovaním osobných údajov na účel odpovede.</span>
      </label>
      <button class="btn" type="submit" style="justify-self:start;">Odoslať</button>
    </form>

    <p class="note" style="margin-top:var(--space-4);">Erika Zajaková · IČO 40485242</p>
  </section>
</BaseLayout>
