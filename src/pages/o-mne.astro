---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-6);
    align-items: start;
    padding-block: var(--space-6) var(--space-5);
  }

  .about-content .eyebrow { margin-bottom: var(--space-2); }
  .about-content h1 { margin-bottom: var(--space-4); }
  .about-content .prose > * + * { margin-top: var(--space-3); }
  .about-content .badges { margin-top: var(--space-4); }
  .about-content .btn { margin-top: var(--space-5); }

  .about-visual { display: flex; flex-direction: column; gap: var(--space-4); }

  .about-photo img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }

  .credentials {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .cred {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }
  .cred strong {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--color-brand-strong);
    display: block;
  }
  .cred span {
    font-size: var(--step--1);
    color: var(--color-muted);
    display: block;
  }
  .h1-rule {
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
    border: none;
    margin-block: var(--space-3) var(--space-4);
    margin-inline: 0;
  }
  .cred--with-badge {
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
  }
  .about-meta {
    font-size: var(--step--1);
    color: var(--color-muted);
    margin-top: var(--space-3);
    letter-spacing: 0.02em;
  }
  @media (max-width: 52rem) {
    .about-grid { grid-template-columns: 1fr; gap: var(--space-5); }
    /* phone: photo first, then name and text, then Skúsenosti */
    .about-visual { display: contents; }
    .about-photo { order: -1; }
  }
</style>
<BaseLayout
  title="O mne | Erika Zajaková"
  description="Erika Zajaková, Ing. Finančná poradkyňa OVB od roku 2002, daňové priznania a jednoduché účtovníctvo od roku 2006. Kancelária v Brezne."
>
  <div class="about-grid">
    <div class="about-content">
      <h1>Erika Zajaková</h1>
      <div class="prose">
        <p>Finančnému poradenstvu sa venujem od roku 2002 v spoločnosti OVB Allfinanz Slovensko. Od roku 2006 popri tom spracúvam daňové priznania a vediem jednoduché účtovníctvo ako samostatne zárobkovo činná osoba.</p>
        <p>Ekonómiu a financie som vyštudovala na vysokej škole Bankovní institut v Prahe (Ing., 2015). Kanceláriu mám v Brezne a s klientmi z iných miest pracujem aj na diaľku.</p>
        <p>Pri daniach aj financiách vám vysvetlím každý krok jednoduchou rečou, aby ste vedeli, za čo platíte a prečo.</p>
      </div>
      <hr class="divider" />
      <p class="about-meta">Prax od roku 2002 · Ing., financie a ekonómia · OVB Allfinanz · IČO 40485242</p>
      <p style="margin-top: var(--space-4);"><a class="btn" href="/kontakt">Konzultácia</a></p>
    </div>

    <div class="about-visual">
      <picture class="about-photo"><source type="image/webp" srcset="/images/erika-zajakova-portret-640.webp 640w, /images/erika-zajakova-portret-1024.webp 1024w" sizes="(max-width: 52rem) 100vw, 480px" /><img src="/images/erika-zajakova-portret-1024.jpg" srcset="/images/erika-zajakova-portret-640.jpg 640w, /images/erika-zajakova-portret-1024.jpg 1024w" sizes="(max-width: 52rem) 100vw, 480px" alt="Ing. Erika Zajaková pri pracovnom stole" width="1024" height="1280" fetchpriority="high" /></picture>
      <h2 class="about-subhead">Skúsenosti</h2>
      <div class="credentials">
        <div class="cred cred--with-badge">
          <div class="badge-seal">OVB<br/>2002</div>
          <div>
            <strong>OVB Allfinanz Slovensko</strong>
            <span>Finančná poradkyňa od roku 2002</span>
          </div>
        </div>
        <div class="cred">
          <strong>Ing., Bankovní institut Praha</strong>
          <span>Financie a ekonómia, 2015</span>
        </div>
        <div class="cred">
          <strong>Kancelária v Brezne</strong>
          <span>Klienti z regiónu, na diaľku aj z celého Slovenska</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
