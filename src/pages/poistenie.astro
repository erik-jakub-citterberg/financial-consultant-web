---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
const faq = [
  { q: 'Aké druhy poistenia robíte?', a: 'Životné, majetkové, PZP a havarijné poistenie vozidiel, cestovné poistenie aj korporátne poistenie firiem. Na stretnutí prejdeme, čo dáva zmysel pre vás.' },
  { q: 'Koľko stojí konzultácia?', a: 'Prvá konzultácia je bezplatná a nezáväzná.' },
  { q: 'Pomôžete aj pri poistnej udalosti?', a: 'Áno. Poradím, ako postupovať, a pomôžem s nahlásením poistnej udalosti.' },
];
---
<BaseLayout
  title="Poistenie Brezno | Erika Zajaková"
  description="Životné, majetkové, PZP a korporátne poistenie v regióne Brezno. Konzultácia zdarma, cez OVB Allfinanz."
>
  <section class="section" data-reveal>
    <h1>Poistenie</h1>
    <p class="lede">Životné, majetkové, PZP aj korporátne poistenie nastavím podľa toho, čo naozaj potrebujete, bez zbytočných pripoistení.</p>

    <div class="cards">
      <article class="card"><h3>Životné poistenie</h3><p>Ochrana príjmu a rodiny pre prípad choroby, úrazu alebo výpadku príjmu.</p></article>
      <article class="card"><h3>Poistenie majetku</h3><p>Poistenie domu, bytu a domácnosti proti bežným rizikám.</p></article>
      <article class="card"><h3>PZP a havarijné</h3><p>Povinné zmluvné poistenie a havarijné poistenie vozidiel. Porovnám ponuky a nastavím optimálne krytie.</p></article>
      <article class="card"><h3>Korporátne poistenie</h3><p>Poistenie firmy, zodpovednosti za škodu, majetku podniku a zamestnancov.</p></article>
      <article class="card"><h3>Audit zmlúv</h3><p>Prejdem vaše existujúce zmluvy a poviem, kde platíte zbytočne veľa.</p></article>
    </div>

    <p class="note" style="margin-top:var(--space-4);">Konzultácia je bezplatná a nezáväzná.</p>

    <h2 style="margin-top:var(--space-5);">Časté otázky</h2>
    <Faq items={faq} />

    <p style="margin-top:var(--space-5);"><a class="btn" href="/kontakt">Dohodnúť si konzultáciu</a></p>
  </section>
</BaseLayout>
